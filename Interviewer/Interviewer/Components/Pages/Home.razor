@page "/"
@using Interviewer.Data.Interfaces
@using Interviewer.Data.Models
@using Interviewer.Data.Repositories
@rendermode InteractiveServer
@inject IInterviewRepository Repository
@inject NavigationManager Nav

<div class="max-w-5xl mx-auto pt-10 px-6 pb-24">

    <div class="mb-10">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Мої співбесіди</h1>
        <p class="text-gray-500">Керуйте процесом оцінювання та переглядайте результати кандидатів.</p>
    </div>

    @if (isLoading)
    {
        <div class="space-y-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 animate-pulse flex justify-between items-center">
                    <div class="space-y-3 w-1/3">
                        <div class="h-5 bg-gray-200 rounded w-3/4"></div>
                        <div class="h-4 bg-gray-100 rounded w-1/2"></div>
                    </div>
                    <div class="h-8 bg-gray-100 rounded-full w-24"></div>
                </div>
            }
        </div>
    }
    else if (!interviews.Any())
    {
        <div class="bg-white rounded-3xl p-12 text-center border border-dashed border-gray-300 shadow-sm mt-8">
            <div class="w-16 h-16 bg-green-50 text-[#66B846] rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Немає жодної співбесіди</h3>
            <p class="text-gray-500 max-w-sm mx-auto mb-6">Ви ще не створили жодного плану інтерв'ю. Натисніть кнопку нижче, щоб розпочати.</p>
            <button @onclick='() => Nav.NavigateTo("/new")' class="btn-primary">
                Створити першу співбесіду
            </button>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var interview in interviews)
            {
                var status = GetInterviewStatus(interview);

                <div @onclick="() => OpenInterview(interview.Id, status)"
                     class="bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-200 cursor-pointer flex flex-col md:flex-row md:items-center justify-between gap-4 group">

                    <div class="flex-1">
                        <h3 class="text-lg font-bold text-gray-900 group-hover:text-[#66B846] transition-colors">
                            @(string.IsNullOrWhiteSpace(interview.CandidateName) ? "Невідомий кандидат" : interview.CandidateName)
                        </h3>
                        <div class="flex items-center gap-3 text-sm text-gray-500 mt-1">
                            <span class="font-medium text-gray-700">@interview.Position</span>
                            <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                            <span>@interview.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">

                        @if (status == InterviewStatus.Completed)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#66B846]/10 text-[#66B846]">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#66B846]"></span>
                                Завершено
                            </span>
                        }
                        else if (status == InterviewStatus.InProgress)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-600">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
                                В процесі
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600">
                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                Створено
                            </span>
                        }

                        <div class="text-gray-300 group-hover:text-[#66B846] transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Interview> interviews = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await Repository.GetAllAsync();
            // Сортуємо від найновіших до найстаріших
            interviews = data
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка завантаження: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // Енумератор для зручності
    private enum InterviewStatus { Created, InProgress, Completed }

    private InterviewStatus GetInterviewStatus(Interview interview)
    {
        // Якщо є фінальний звіт — інтерв'ю завершено
        if (!string.IsNullOrEmpty(interview.FinalAiReport))
            return InterviewStatus.Completed;

        // Рахуємо всі питання та питання з оцінками
        int totalQuestions = interview.Topics.SelectMany(t => t.Questions).Count();
        int answeredQuestions = interview.Topics.SelectMany(t => t.Questions).Count(q => q.Score.HasValue);

        if (totalQuestions > 0 && answeredQuestions > 0)
            return InterviewStatus.InProgress;

        return InterviewStatus.Created;
    }

    private void OpenInterview(string id, InterviewStatus status)
    {
        switch (status)
        {
            case InterviewStatus.Completed:
                Nav.NavigateTo($"/report/{id}");
                break;
            case InterviewStatus.InProgress:
                Nav.NavigateTo($"/interview/{id}");
                break;
            case InterviewStatus.Created:
                Nav.NavigateTo($"/review/{id}");
                break;
        }
    }
}