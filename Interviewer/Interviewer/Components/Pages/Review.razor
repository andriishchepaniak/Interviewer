@page "/review"
@page "/review/{Id}"
@using Interviewer.Data.Interfaces
@using Interviewer.Data.Models
@using Interviewer.Services
@using Interviewer.State
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject InterviewState State
@inject IInterviewGeneratorService Generator
@inject IInterviewRepository Repository


<div class="min-h-screen bg-white flex flex-col">

    <header class="bg-white border-b border-gray-200 px-6 py-3 flex justify-between items-center sticky top-0 z-20">
        <div class="flex items-center gap-3">
            <button @onclick='() => Nav.NavigateTo("/")' class="btn-secondary" title="Повернутися на головну">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
            </button>

            <div>
                <h1 class="text-lg font-bold text-gray-800">Редагування плану (Draft)</h1>
                <p class="text-xs text-gray-500">Кандидат: <span class="font-medium text-gray-700">@State.Current.CandidateName</span> | @State.Current.Position</p>
            </div>
        </div>

        <button @onclick="StartInterview" disabled="@(!CanStart || isLoading || isSaving)" class="btn-primary flex items-center gap-2">
            Перейти до співбесіди
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 font-bold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
        </button>
    </header>

    <main class="flex-1 overflow-y-auto p-6 md:px-12 py-8">
        <div class="max-w-6xl mx-auto pb-12">
            @if (isLoading)
            {
                <div class="space-y-10">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="animate-pulse">
                            <div class="h-8 bg-gray-200 rounded w-1/3 mb-5"></div>

                            <div class="grid grid-cols-12 gap-4 px-2 mb-3">
                                <div class="col-span-7 h-4 bg-gray-100 rounded w-1/4"></div>
                                <div class="col-span-4 h-4 bg-gray-100 rounded w-1/2"></div>
                            </div>

                            <div class="flex flex-col gap-3">
                                @for (int j = 0; j < 2; j++)
                                {
                                    <div class="grid grid-cols-12 gap-4 items-start p-2">
                                        <div class="col-span-7 h-16 bg-gray-100 border border-gray-200 rounded-lg"></div>
                                        <div class="col-span-4 h-16 bg-gray-100 border border-gray-200 rounded-lg"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-8 text-center text-gray-400 text-sm animate-pulse flex justify-center items-center gap-2">
                    <svg class="animate-spin h-4 w-4 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    AI аналізує вимоги та формує найкращі питання...
                </div>
            }
            else if (!State.Current.Topics.Any())
            {
                <div class="bg-gray-50 rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-500">
                    План співбесіди порожній.
                </div>
            }
            else
            {
                <div class="space-y-10">
                    @foreach (var topic in State.Current.Topics)
                    {
                        <div class="animate-fade-in-up">

                            <div class="flex items-center gap-3 border-b-2 border-gray-800 pb-2 mb-1 group">
                                <input @bind="topic.Title" @bind:event="oninput"
                                       class="text-xl font-bold text-gray-900 bg-transparent border-transparent hover:bg-gray-100 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 rounded px-2 py-1 w-full transition-all outline-none placeholder-gray-300"
                                       placeholder="Назва теми..." />

                                <button @onclick="() => RemoveTopic(topic)" class="text-gray-300 hover:text-red-500 p-1.5 rounded transition opacity-0 group-hover:opacity-100" title="Видалити тему">
                                    🗑️
                                </button>
                            </div>

                            <div class="grid grid-cols-12 gap-4 px-2 mb-1 text-xs font-bold text-gray-400 uppercase tracking-wider">
                                <div class="col-span-7">Питання</div>
                                <div class="col-span-4">Очікувана відповідь (Hint)</div>
                                <div class="col-span-1"></div>
                            </div>

                            <div class="flex flex-col gap-1">
                                @foreach (var q in topic.Questions)
                                {
                                    <div class="grid grid-cols-12 gap-4 items-start group hover:bg-gray-50 p-2 rounded-lg transition-colors border border-transparent hover:border-gray-100">

                                        <div class="col-span-7">
                                            <textarea @bind="q.Text" @bind:event="oninput" rows="2"
                                                      class="w-full text-sm font-medium text-gray-900 bg-transparent border border-transparent hover:border-gray-300 focus:bg-white focus:border-blue-500 focus:ring-1 focus:ring-blue-500 rounded p-1.5 resize-y outline-none transition-colors"
                                                      placeholder="Введіть питання..."></textarea>
                                        </div>

                                        <div class="col-span-4 relative">
                                            <div class="absolute top-2.5 left-2 text-blue-400 text-xs">💡</div>
                                            <textarea @bind="q.Hint" @bind:event="oninput" rows="2"
                                                      class="w-full text-sm text-gray-600 bg-transparent border border-transparent hover:border-gray-300 focus:bg-white focus:border-blue-500 focus:ring-1 focus:ring-blue-500 rounded py-1.5 pr-1.5 pl-6 resize-y outline-none transition-colors"
                                                      placeholder="Ключові тези..."></textarea>
                                        </div>

                                        <div class="col-span-1 flex justify-end pt-1">
                                            <button @onclick="() => RemoveQuestion(topic, q)" class="text-gray-300 hover:text-red-600 hover:bg-red-50 p-1.5 rounded transition opacity-0 group-hover:opacity-100" title="Видалити питання">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                }

                                <div class="px-2 mt-1">
                                    <button @onclick="() => AddQuestion(topic)" class="text-xs font-bold text-gray-400 hover:text-blue-600 transition flex items-center gap-1 py-1">
                                        <span>+ Додати питання</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="pt-4 border-t border-gray-100">
                        <button @onclick="AddTopic" class="text-sm font-bold text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-4 py-2 rounded-lg transition flex items-center gap-2">
                            <span>+ Додати нову тему</span>
                        </button>
                    </div>

                </div>
            }
        </div>
    </main>
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private bool isLoading = false;
    private bool isSaving = false;

    private bool CanStart => State.Current.Topics.Any(t => t.Questions.Any(q => !string.IsNullOrWhiteSpace(q.Text)));

    protected override async Task OnInitializedAsync()
    {
        // /review/{Id} — редагування вже збереженого плану (перехід з дашборду).
        if (!string.IsNullOrEmpty(Id))
        {
            if (State.Current.Id != Id)
            {
                var interviewFromDb = await Repository.GetByIdAsync(Id);
                if (interviewFromDb == null)
                {
                    Nav.NavigateTo("/");
                    return;
                }

                State.Current = interviewFromDb;
            }

            State.IsPersisted = true;
            return;
        }

        // /review — чернетка, ще не збережена в базі.
        if (State.IsGeneratingRequested)
        {
            isLoading = true;
        }
        else if (string.IsNullOrEmpty(State.Current.Position) && !State.Current.Topics.Any())
        {
            Nav.NavigateTo("/");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && State.IsGeneratingRequested)
        {
            State.IsGeneratingRequested = false;

            try
            {
                var generatedTopics = await Generator.GenerateInterviewPlanAsync(State.Current.Position, State.Current.CvText);

                if (generatedTopics != null && generatedTopics.Any())
                {
                    State.Current.Topics = generatedTopics;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Помилка: {ex.Message}");
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void RemoveQuestion(Topic topic, Question q)
    {
        topic.Questions.Remove(q);
    }

    private void AddQuestion(Topic topic)
    {
        topic.Questions.Add(new Question { Text = "", Hint = "" });
    }

    private void RemoveTopic(Topic topic)
    {
        State.Current.Topics.Remove(topic);
    }

    private void AddTopic()
    {
        State.Current.Topics.Add(new Topic
        {
            Id = State.Current.Topics.Any() ? State.Current.Topics.Max(t => t.Id) + 1 : 1,
            Title = "",
            Questions = new List<Question> { new Question { Text = "", Hint = "" } }
        });
    }

    private async Task StartInterview()
    {
        // Захист від подвійного кліку: два CreateAsync до того, як виставиться IsPersisted, дали б дублікат.
        if (isSaving) return;
        isSaving = true;

        try
        {
            if (State.IsPersisted)
            {
                await Repository.UpdateAsync(State.Current.Id, State.Current);
            }
            else
            {
                await Repository.CreateAsync(State.Current);
                State.IsPersisted = true;
            }
        }
        finally
        {
            isSaving = false;
        }

        var id = State.Current.Id;

        if (!string.IsNullOrEmpty(id)) Nav.NavigateTo($"/interview/{id}");
    }
}