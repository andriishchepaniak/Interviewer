@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<div class="min-h-screen bg-gray-50 relative font-sans text-gray-900 selection:bg-blue-200">

    <main class="w-full h-full pb-28 lg:pb-0">
        @Body
    </main>

    <nav class="floating-dock left-1/2 -translate-x-1/2 lg:translate-x-0 lg:left-8">

        <NavLink href="/" Match="NavLinkMatch.All" class="dock-item">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
        </NavLink>

        <div class="dock-divider"></div>

        <NavLink href="/templates" class="dock-item">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
        </NavLink>

        <div class="dock-divider"></div>

        <NavLink href="/settings" class="dock-item">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-[22px] w-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
        </NavLink>
    </nav>

    @if (!IsInInterviewPage)
    {
        <NavLink href="/new" class="floating-fab">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span class="hidden sm:inline">Нова співбесіда</span>
        </NavLink>
    }
</div>

@code {
    // Властивість, яка перевіряє, чи закінчується поточний URL на "new"

    private string RelativePath => Nav.ToBaseRelativePath(Nav.Uri);

    private bool IsInInterviewPage => 
        RelativePath.Contains("new", StringComparison.OrdinalIgnoreCase)
        || RelativePath.Contains("review", StringComparison.OrdinalIgnoreCase)
        || RelativePath.Contains("interview", StringComparison.OrdinalIgnoreCase)
        || RelativePath.Contains("report", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // Підписуємося на зміну адреси, щоб Blazor перемальовував Layout при переходах
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        // Важливо відписатися, щоб уникнути витоку пам'яті (Memory Leaks)
        Nav.LocationChanged -= OnLocationChanged;
    }
}